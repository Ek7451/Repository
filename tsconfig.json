{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM"],
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "export/**/*.js",
    "tests/**/*.js",
    "scripts/**/*.mjs",
    "eslint.config.js",
    "vitest.config.js"
  ]
}
