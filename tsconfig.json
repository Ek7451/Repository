{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM"],
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "app.js",
    "ui/app.js",
    "pages/dashboard/dashboard.js",
    "services/**/*.js",
    "state/**/*.js",
    "core/sightline-calc.js",
    "export/**/*.js",
    "tests/**/*.js",
    "scripts/**/*.mjs",
    "eslint.config.js",
    "vitest.config.js"
  ]
}
